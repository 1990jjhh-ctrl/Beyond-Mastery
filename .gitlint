# Commit message rules, checked locally by the gitlint commit-msg hook and in
# CI on every pull request. See docs/development.md, "Contributing".

[general]
# Titles follow Conventional Commits: "<type>(<scope>)?: <description>".
contrib=contrib-title-conventional-commits
# A one-line commit needs no body; the Co-Authored-By trailer is a body anyway.
ignore=body-is-missing

[title-max-length]
line-length=72

[body-max-line-length]
line-length=80

[contrib-title-conventional-commits]
types=feat,fix,docs,build,ci,chore,refactor,style,test,perf,revert
